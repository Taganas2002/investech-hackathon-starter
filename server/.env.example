PORT=3001

# Base URL only. Do not include a secret in the path.
ORGANIZER_API_URL=

# Leave blank until the organizers issue a key. Do not commit the real .env.
ORGANIZER_API_KEY=

# Use Authorization or x-api-key.
ORGANIZER_AUTH_HEADER=Authorization

# "Bearer" sends "Bearer <key>". Leave blank to send the raw key.
ORGANIZER_AUTH_SCHEME=Bearer
