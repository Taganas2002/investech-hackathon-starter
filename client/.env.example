# Leave blank in local Vite (proxies /api → localhost:3001).
# Leave blank on Vercel Services too — public /api rewrites hit the Express service.
# Only set this if the API is on a different origin. No trailing slash. No secrets.
VITE_API_BASE_URL=

# Optional and browser-visible. Do not put Onesheet/organizer secrets here.
# Prefer server-side ORGANIZER_API_KEY / ONESHEET_API_KEY instead.
VITE_API_KEY=
